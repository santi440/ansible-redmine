receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 512
    spike_limit_mib: 128
  resource/add_environment:
    attributes:
      - key: deployment.environment
        value: production
        action: upsert
  batch:
    timeout: 5s
    send_batch_size: 512
  transform/add_traceid_label:
    metric_statements:
      - context: exemplar
        statements:
          - set(exemplar.filtered_attributes["traceID"], exemplar.trace_id.string)

connectors:
  spanmetrics:
    namespace: traces.span.metrics
    metrics_flush_interval: 15s
    dimensions:
      - name: http.response.status_code
    exemplars:
      enabled: true
      max_per_data_point: 5
    resource_metrics_key_attributes:
      - service.name
      - service.namespace
      - deployment.environment

extensions:
  basicauth/grafana_cloud:
    client_auth:
      username: ${env:GRAFANA_CLOUD_INSTANCE_ID}
      password: ${env:GRAFANA_CLOUD_API_KEY}

exporters:
  otlphttp/grafana_cloud:
    endpoint: ${env:GRAFANA_CLOUD_OTLP_ENDPOINT}
    auth:
      authenticator: basicauth/grafana_cloud
  prometheus/local:
    endpoint: 0.0.0.0:8889

service:
  extensions: [basicauth/grafana_cloud]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, resource/add_environment, batch]
      exporters: [otlphttp/grafana_cloud, spanmetrics]
    metrics:
      receivers: [spanmetrics]
      processors: [memory_limiter, transform/add_traceid_label, batch]
      exporters: [otlphttp/grafana_cloud, prometheus/local]
  telemetry:
    metrics:
      level: detailed
      readers:
        - pull:
            exporter:
              prometheus:
                host: '0.0.0.0'
                port: 8888
